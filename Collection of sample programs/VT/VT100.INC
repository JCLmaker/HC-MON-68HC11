*** SET CURSOR POSITION ***

CURSOR:	.MACRO	ZEILE,SPALTE
	LDX	#TEXT#
	JSR	PRINT
	BRA	RAUS#
TEXT#:	DB	$1B,'[',ZEILE,';',SPALTE,'H',0
RAUS#:
	.ENDM

*** SET SCROLLING REGION ***

SCROLL:	.MACRO	OBEN,UNTEN
	LDX	#TEXT#
	JSR	PRINT
	BRA	RAUS#
TEXT#:	DB	$1B,'[',OBEN,';',UNTEN,'r',0
RAUS#:
	.ENDM

